{
  "name": "breachguard",
  "productName": "BreachGuard",
  "version": "1.0.0",
  "description": "BreachGuard — Zero-Knowledge Credential Defense & Real-Time Ransomware Mitigation",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "BreachGuard Team",
  "scripts": {
    "dev": "vite --port 5173",
    "bridge": "node server/bridge.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite --port 5173\" \"wait-on http://localhost:5173 && electron .\"",
    "desktop:build": "tsc && vite build",
    "installer": "node scripts/package-desktop.cjs"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "innosetup-compiler": "^6.3.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.breachguard.soc",
    "productName": "BreachGuard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "driver",
        "to": "driver",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icons/breachguard.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BreachGuard",
      "uninstallDisplayName": "BreachGuard Cyber Defense SOC"
    }
  }
}
